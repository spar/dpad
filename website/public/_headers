# Cloudflare reads this file and adds these headers. It is not served.
# https://developers.cloudflare.com/workers/static-assets/headers/
# The HTML pages set their Content-Security-Policy in a meta tag, so it doesn't
# also apply to the SVG screenshots, which carry their own styles and fonts.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# `make website` adds ?v=<hash of the assets> to every asset address in the
# pages, so a changed file gets a new address and browsers can keep these for a
# year. The fonts have no ?v= (site.css asks for them by name): give a changed
# font a new file name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep preview builds out of search results: pull request previews on
# <branch>.dpad.sh or <version>.dpad.sh, and every workers.dev address.
# dpad.sh itself has no subdomain, so it doesn't match.
https://:preview.dpad.sh/*
  X-Robots-Tag: noindex

https://:name.:account.workers.dev/*
  X-Robots-Tag: noindex
