# Copy to .env (git ignores it). See docs/self-hosted-runner.md.

# Only needed for first registration; one token can register all three runners
# within its one-hour lifetime. Clear it after registration, then recreate the
# containers so their configured environment no longer contains the token.
# gh api -X POST repos/spar/dockernext/actions/runners/registration-token --jq .token
RUNNER_TOKEN=

# Optional settings. Defaults keep this stack separate from Expense Tracker.
# RUNNER_NAME_PREFIX=dockernext
# RUNNER_WORK_ROOT=/opt/dockernext-actions-runner
# RUNNER_LABELS=dockernext
# RUNNER_REPOSITORY_URL=https://github.com/spar/dockernext
# RUNNER_CACHE_LIMIT_GB=10

# Set the repository Actions variable CI_RUNNER to self-hosted after these
# runners are online. CI_RUNNER is configured on GitHub, not in this .env file.
